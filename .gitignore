__pycache__/
*.pyc
versions.lock.bak

# The image and the tree it is made from. Multi-gigabyte and root-owned; 'rm
# -rf' on it needs sudo.
/build/

# Component tarballs, staged here by 'make stage' from each component's own
# 'make dist'. The checksums beside them are committed; the tarballs are not -
# they are built output and they are large.
/distros/*/sources/*.tar.*

# Credentials, never. Named broadly on purpose: the failure mode is a file
# nobody thought to ignore being swept up by 'git add -A', and a pattern that
# only covers the one file you remember is not much better than nothing.
/secrets
/secrets.d/
*.key
*.pem
.env
.env.*
!.env.example

# An image carrying a credential. Never a release artifact, never shared, and
# never confusable with the image it was copied from — which is what the name
# is for.
# The image itself, because it carries credentials now — seed-image.sh writes
# them in place rather than into a second copy. /build/ is ignored above, so
# this is belt and braces for an image left anywhere else.
*.img

# An adapter brings its own dependencies; cogiti has none. The virtualenv is
# the adapter's environment, not a thing to commit.
.venv/
