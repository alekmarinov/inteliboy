#!/bin/sh
########################################################################
# Begin cogiti
#
# Description : Starts the InteliBoy brain
# Author      : InteliBoy
#
########################################################################

### BEGIN INIT INFO
# Provides:          cogiti
# Required-Start:    $network avatari
# Should-Start:
# Required-Stop:
# Default-Start:     3 4 5
# Default-Stop:      0 1 2 6
# Short-Description: Starts the InteliBoy brain.
# Description:       Resolve, act, escalate. Listens through audi and answers
#                    through avatari.
### END INIT INFO

. /lib/lsb/init-functions

COGITI=/usr/bin/cogiti
PIDFILE=/run/cogiti.pid
LOG=/var/log/cogiti.log

case "$1" in
   start)
      log_info_msg "Starting the InteliBoy brain..."
      if [ ! -x "$COGITI" ]; then
         log_failure_msg2
         exit 1
      fi
      install -d -m 0700 /var/lib/cogiti

      # Supervised in the background, in the same shape as the renderer beside
      # it. LFS's bootscripts have no start_stop_daemon — that is Debian's, and
      # using it here failed with 'command not found' at boot, printed FAIL,
      # and exited 0, so nothing downstream noticed the brain had not started.
      #
      # The restart loop is not belt and braces. The brain holds the speech
      # adapter as a child, and a device that has gone deaf and does not
      # mention it is the worst way for this to fail.
      (
         echo $$ > "$PIDFILE"
         fails=0
         while true; do
            started=$(cut -d. -f1 /proc/uptime)
            "$COGITI" >>"$LOG" 2>&1
            ran=$(( $(cut -d. -f1 /proc/uptime) - started ))

            # One that dies immediately, repeatedly, is a missing model or a
            # bad path and will not start on the next attempt either. Stop, and
            # leave the reason in the log rather than looping over it forever.
            if [ "$ran" -lt 10 ]; then
               fails=$(( fails + 1 ))
            else
               fails=0
            fi
            if [ "$fails" -ge 3 ]; then
               echo "cogiti failed to stay up 3 times; giving up" >>"$LOG"
               exit 1
            fi
            sleep 2
         done
      ) </dev/null >/dev/null 2>&1 &
      evaluate_retval
      ;;

   stop)
      log_info_msg "Stopping the InteliBoy brain..."
      if [ -f "$PIDFILE" ]; then
         kill "$(cat "$PIDFILE")" 2>/dev/null
         pkill -f "$COGITI" 2>/dev/null
         rm -f "$PIDFILE"
      fi
      evaluate_retval
      ;;

   restart)
      $0 stop
      sleep 2
      $0 start
      ;;

   status)
      if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
         echo "cogiti is running"
      else
         echo "cogiti is not running"
         exit 3
      fi
      ;;

   *)
      echo "Usage: $0 {start|stop|restart|status}"
      exit 1
      ;;
esac

exit 0
